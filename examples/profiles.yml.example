# Example only. Do not commit keys. quoting belongs in dbt_project.yml.
atomic_promotion:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "<org>-<account>"
      user: "<user>"
      role: "<role that owns the project schemas>"
      warehouse: "<warehouse>"
      database: "<database>"
      schema: analytics
      threads: 4
      authenticator: externalbrowser
